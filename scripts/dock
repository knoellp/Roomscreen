#!/usr/bin/env bash
# Run a command inside the roomscreen-android toolchain image as the host user.
# Host networking: needed for adb connect and SOOD multicast/broadcast.
set -euo pipefail
cd "$(dirname "$0")/.."
IMAGE=roomscreen-android
mkdir -p "$HOME/.android" "$HOME/.config/roomscreen-cli"
ENVFILE=()
[ -f config/local.env ] && ENVFILE+=(--env-file config/local.env)
# Release signing (gitignored): RELEASE_KEYSTORE, RELEASE_KEYSTORE_PASSWORD, RELEASE_KEY_ALIAS, RELEASE_KEY_PASSWORD
[ -f config/signing.env ] && ENVFILE+=(--env-file config/signing.env)
TTY=""; [ -t 0 ] && TTY="-it"
exec docker run --rm $TTY --network host \
  "${ENVFILE[@]}" \
  --user "$(id -u):$(id -g)" \
  -v "$PWD":/work \
  -v roomscreen-gradle-home:/gradle-home \
  -v "$HOME/.android":/home/dev/.android \
  -v "$HOME/.config/roomscreen-cli":/home/dev/.config/roomscreen-cli \
  -e ROOMSCREEN_CLI_CONFIG=/home/dev/.config/roomscreen-cli \
  -e JAVA_OPTS="-Duser.home=/home/dev" \
  -e GRADLE_OPTS="-Xmx1g" \
  "$IMAGE" "$@"
