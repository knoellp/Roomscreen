<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug-only hooks: adb shell am broadcast -a io.github.knoellp.roomscreen.DUMP_STATE -->
        <receiver android:name=".DebugReceiver" android:exported="true">
            <intent-filter>
                <action android:name="io.github.knoellp.roomscreen.DUMP_STATE" />
                <action android:name="io.github.knoellp.roomscreen.SET_HOST" />
                <action android:name="io.github.knoellp.roomscreen.RESET" />
                <action android:name="io.github.knoellp.roomscreen.CLEAR_ENDPOINT" />
                <action android:name="io.github.knoellp.roomscreen.DUMP_ZONES" />
                <action android:name="io.github.knoellp.roomscreen.SET_VIA_ROON" />
                <action android:name="io.github.knoellp.roomscreen.SET_KEY_SOUNDS" />
                <action android:name="io.github.knoellp.roomscreen.SELECT_ZONE" />
                <action android:name="io.github.knoellp.roomscreen.SET_LYRICS" />
                <action android:name="io.github.knoellp.roomscreen.OPEN_VOLUME" />
                <action android:name="io.github.knoellp.roomscreen.SET_SHARPNESS" />
                <action android:name="io.github.knoellp.roomscreen.SET_BACKGROUND" />
                <action android:name="io.github.knoellp.roomscreen.SET_LRCLIB" />
                <action android:name="io.github.knoellp.roomscreen.SET_LYRICS_OFFSET" />
                <action android:name="io.github.knoellp.roomscreen.SET_SCREEN_ON" />
                <action android:name="io.github.knoellp.roomscreen.OPEN_DIAGNOSTICS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
