# Copy to config/signing.env (gitignored). Loaded by scripts/dock.
# Create the keystore once (see docs/RELEASING.md) and back it up outside the repository together with these passwords.
# Losing the keystore means no further updates over an installed app.
RELEASE_KEYSTORE=config/release.jks
RELEASE_KEYSTORE_PASSWORD=
RELEASE_KEY_ALIAS=roomscreen
RELEASE_KEY_PASSWORD=
