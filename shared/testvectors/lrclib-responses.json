{
 "description": "LRCLIB HTTP answers and the result the client must produce (docs/SPEC.md lyrics). Derived 1:1 from LrclibClientTest, except the timeout test (stays a Kotlin test). responses are served in order, one per HTTP request; retries after 5xx/429/IO error happen immediately in these vectors (retry delays 0, two retries, so up to 3 requests); 404 is NotFound; other 4xx and unparsable bodies are Unavailable. expect.kind is found, notFound or unavailable; for found: synced (lines or null), plain, instrumental. expectRequest: path, query parameters that must have these values, absentQuery parameters that must not be sent, userAgent. User agent version is 9.9 in these vectors.",
 "userAgentVersion": "9.9",
 "cases": [
  {
   "name": "syncedResponseAndRequestShape",
   "endpoint": "get",
   "query": {
    "title": "Fortress Around Your Heart",
    "artist": "Sting",
    "album": "The Dream Of The Blue Turtles",
    "durationSec": 280
   },
   "responses": [
    {
     "status": 200,
     "bodyJson": {
      "id": 1,
      "trackName": "x",
      "artistName": "y",
      "albumName": "z",
      "duration": 280.0,
      "instrumental": false,
      "plainLyrics": "Under the ruins\nSecond",
      "syncedLyrics": "[00:17.84] Under the ruins\n[00:25.00] Second"
     }
    }
   ],
   "expect": {
    "kind": "found",
    "synced": [
     {
      "timeMs": 17840,
      "text": "Under the ruins"
     },
     {
      "timeMs": 25000,
      "text": "Second"
     }
    ],
    "plain": "Under the ruins\nSecond",
    "instrumental": false
   },
   "expectRequest": {
    "path": "/api/get",
    "query": {
     "track_name": "Fortress Around Your Heart",
     "artist_name": "Sting",
     "album_name": "The Dream Of The Blue Turtles",
     "duration": "280"
    }
   }
  },
